# Ubuntu 24.04 (glibc 2.39): the registry 'assembly' extension downloads asm-lsp, which needs GLIBC_2.39.
FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl xz-utils \
    sway grim \
    mesa-vulkan-drivers libgl1-mesa-dri libvulkan1 vulkan-tools \
    libwayland-client0 libwayland-cursor0 libxkbcommon0 \
    fonts-dejavu-core fonts-liberation2 fonts-noto \
    clangd git python3 python3-pip \
    wl-clipboard libasound2t64 libxkbcommon-x11-0 libfontconfig1 procps \
    && rm -rf /var/lib/apt/lists/*

# uv
RUN curl -fsSL https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

# Zed tarball
RUN curl -fSL -o /tmp/zed.tar.gz \
      https://zed.dev/api/releases/stable/latest/zed-linux-x86_64.tar.gz \
    && mkdir -p /opt && tar -xzf /tmp/zed.tar.gz -C /opt \
    && ln -sf /opt/zed.app/bin/zed /usr/local/bin/zed \
    && rm /tmp/zed.tar.gz

RUN userdel -r ubuntu; useradd -m -u 1000 shot
RUN mkdir -p /etc/sway && mkdir -p /tmp/xdg-runtime && chmod 1777 /tmp
COPY sway.config /etc/sway/config
COPY in-container.sh /rig/in-container.sh
RUN chmod +x /rig/in-container.sh
USER shot
WORKDIR /home/shot
ENV XDG_RUNTIME_DIR=/tmp/xdg-runtime
RUN mkdir -p /tmp/xdg-runtime

CMD ["true"]
